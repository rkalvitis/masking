Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# ---------------------------------------------------------------
# gtbench — Singularity container for the ground-truth mask benchmark
# (repos/masking/gtbench: SAM ViT-H, SAM 2.1, HQ-SAM, SAM 3, BiRefNet, rembg, GrabCut).
#
# Same layout as the lab's 3dgs.sif / masked-3dgs.sif (Miniconda in /opt/conda, one env),
# but a NEWER stack, because those containers (python 3.8, torch 2.0, CUDA 11.8) cannot run
# SAM 2 / SAM 3 / transformers 5:
#   Python        3.11
#   PyTorch       2.6.0 (cu124 pip wheel; sm_89 = RTX 4080 included; transformers 5.19 needs torch >= 2.6 for torch.accelerator)
#   transformers  >= 5 (Sam2Model, Sam3Model, BiRefNet remote code)
#   rembg[gpu] + onnxruntime-gpu (CUDA 12 / cuDNN 9 build), segment-anything-hq (HQ-SAM v1),
#   HQ-SAM 2 from github.com/SysCV/sam-hq/sam-hq2 (installs as package `sam2`; compiles a CUDA ext with nvcc)
#
# Server layout (rhea):  code      /home/robertsk/masking            (bound at /workspace)
#                        container /home/robertsk/containers/gtbench.sif
#                        bench     /media/white/nanodrones/roberts.kalvitis/mask_bench   (bound at /bench)
#                                  gt/{images,masks}  results/<method>/  weights/
# Build (~15 min, needs network):
#   singularity build --fakeroot /home/robertsk/containers/gtbench.sif /home/robertsk/masking/gtbench/gtbench.def
# First-run check WITH the GPU (model imports cannot be tested at build time, there is no GPU in `build`):
#   singularity exec --nv --cleanenv --contain --bind /home/robertsk/masking:/workspace \
#       /home/robertsk/containers/gtbench.sif bash -c "cd /workspace && python -m gtbench.selfcheck"
#
# Run:
#   export SINGULARITYENV_CUDA_VISIBLE_DEVICES=0
#   singularity exec --nv --cleanenv --contain \
#       --bind /home/robertsk/masking:/workspace \
#       --bind /media/white/nanodrones/roberts.kalvitis/mask_bench:/bench \
#       /home/robertsk/containers/gtbench.sif bash -c "cd /workspace && \
#       python -m gtbench.run --data /bench/gt --out /bench/results --weights /bench/weights --device cuda && \
#       python -m gtbench.score --data /bench/gt --out /bench/results"
#   (`bash gtbench/sync_to_rhea.sh cmd` on the Mac prints these.)
#
# SAM 3 weights are gated: accept the licence at https://huggingface.co/facebook/sam3, then log in once
# from inside the container with the bench dir bound (`HF_HOME=/bench/weights/hf hf auth login`) or pass
# SINGULARITYENV_HF_TOKEN=<token>. Everything downloads on first use into /bench/weights.
# ---------------------------------------------------------------

%environment
    export PATH=/opt/conda/envs/gtbench/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=gtbench
    export CUDA_HOME=/usr/local/cuda-12.4
    export PATH=/usr/local/cuda-12.4/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda-12.4/lib64:$LD_LIBRARY_PATH
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export OMP_NUM_THREADS=8
    # model caches default to the bound weights dir (gtbench.run --weights overrides)
    export HF_HOME=${HF_HOME:-/bench/weights/hf}
    export U2NET_HOME=${U2NET_HOME:-/bench/weights/rembg}
    export TORCH_HOME=${TORCH_HOME:-/bench/weights/torch}

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        git wget curl ca-certificates build-essential \
        libgl1 libglib2.0-0 libgomp1 libxrender1 libxext6 libsm6
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # ---- Miniconda (same as masked-3dgs.def) ----
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda && rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main || true
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r || true
    /opt/conda/bin/conda create -n gtbench python=3.11 -y
    PIP=/opt/conda/envs/gtbench/bin/pip

    # ---- PyTorch cu124 ----
    $PIP install --no-cache-dir torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cu124

    # ---- benchmark dependencies ----
    $PIP install --no-cache-dir \
        "transformers>=5.0" "huggingface_hub>=1.0" timm kornia einops accelerate \
        opencv-python-headless scikit-image scipy pandas pillow \
        "rembg[gpu]" onnxruntime-gpu segment-anything-hq

    # ---- HQ-SAM 2 (SysCV fork of SAM 2.1; the `sam2` package name is free because SAM 2.1 itself is used via transformers) ----
    export SAM2_BUILD_ALLOW_ERRORS=1
    $PIP install --no-cache-dir "git+https://github.com/SysCV/sam-hq.git#subdirectory=sam-hq2"
    # the package has no MANIFEST.in, so its yaml configs are not installed -> copy them in from the repo
    git clone --depth 1 https://github.com/SysCV/sam-hq.git /tmp/sam-hq
    SAM2DIR=$(/opt/conda/envs/gtbench/bin/python -c "import sam2, os; print(os.path.dirname(sam2.__file__))")
    cp -r /tmp/sam-hq/sam-hq2/sam2/configs "$SAM2DIR"/ && rm -rf /tmp/sam-hq
    ls "$SAM2DIR"/configs/sam2.1/

    # ---- sanity check at build time (NO GPU here) ----
    # transformers 5 model modules call torch.accelerator.current_accelerator() at import time; with
    # torch 2.6 that is a *runtime* device check, so importing Sam2Model etc. raises
    # "Cannot access accelerator device when none is available" inside `singularity build`.
    # Only the GPU-free imports are checked here; the model imports are checked by
    # `python -m gtbench.selfcheck` on the first `singularity exec --nv` (see header).
    /opt/conda/envs/gtbench/bin/python - <<'PY'
import torch, transformers, rembg, segment_anything_hq, onnxruntime as ort, cv2, skimage, pandas
print("torch", torch.__version__, "cuda build", torch.version.cuda)
print("transformers", transformers.__version__, "| onnxruntime providers", ort.get_available_providers())
import importlib.util
for mod in ("transformers.models.sam", "transformers.models.sam2", "transformers.models.sam3",
            "sam2.build_sam", "sam2.sam2_image_predictor"):
    assert importlib.util.find_spec(mod) is not None, f"missing module {mod}"
    print("found", mod)
PY

%runscript
    exec /opt/conda/envs/gtbench/bin/python "$@"
